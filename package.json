{
  "name": "bill-the-mallard",
  "displayName": "Bill the Mallard",
  "description": "Context-aware coding buddy duck",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:billMallardView",
    "onCommand:bill.indexRepository",
    "onCommand:bill.analyzeFile",
    "onCommand:bill.devDiary"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0",
    "@vscode/test-electron": "^2.3.8",
    "mocha": "^10.0.0",
    "@types/mocha": "^10.0.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "billMallard",
          "title": "Bill",
          "icon": "resources/duck.svg"
        }
      ]
    },
    "views": {
      "billMallard": [
        {
          "id": "billMallardView",
          "name": "Bill the Mallard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "bill.indexRepository",
        "title": "Bill: Index Repository 🧠",
        "category": "Bill"
      },
      {
        "command": "bill.analyzeFile",
        "title": "Bill: Analyze & Refactor File 🔨",
        "category": "Bill"
      },
      {
        "command": "bill.devDiary",
        "title": "Bill: Generate Dev Diary 📝",
        "category": "Bill"
      }
    ]
  }
}