{
  "name": "bill-the-mallard",
  "displayName": "Bill the Mallard",
  "description": "Context-aware coding buddy duck",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:billMallardView"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "vscode-test": "^2.5.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "billMallard",
          "title": "Bill",
          "icon": "resources/duck.svg"
        }
      ]
    },
    "views": {
      "billMallard": [
        {
          "id": "billMallardView",
          "name": "Bill the Mallard",
          "type": "webview"
        }
      ]
    }
  }
}